#version 330 core

// Вершинный шейдер неподвижной освещаемой поверхности (дно, стенки).
// Выполняется для каждой вершины: переводит её в координаты отсечения
// и передаёт фрагментному шейдеру нормаль и цвет.

uniform mat4 u_view;        // мировые координаты → координаты камеры
uniform mat4 u_projection;  // координаты камеры → координаты отсечения
uniform vec3 u_color;       // цвет всей поверхности

in vec3 in_position;  // положение вершины в мировых координатах
in vec3 in_normal;    // нормаль поверхности в этой вершине

out vec3 v_normal;
out vec3 v_color;

void main() {
    // Аквариум неподвижен и задан сразу в мировых координатах,
    // поэтому матрица модели (M в цепочке P·V·M) здесь не нужна.
    v_normal = in_normal;
    v_color = u_color;
    gl_Position = u_projection * u_view * vec4(in_position, 1.0);
}
